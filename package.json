{
  "name": "newbiblereviewapp",
  "main": "expo-router/entry",
  "version": "0.11.0-beta",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "preview:android": "eas build --platform android --profile preview",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "db:new": "node scripts/new-migration.js",
    "db:push": "supabase db push",
    "db:pull": "supabase db pull",
    "db:diff": "supabase db diff",
    "db:status": "supabase migration list",
    "db:repair": "supabase migration repair --status applied"
  },
  "dependencies": {
    "@expo/metro-config": "~54.0.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-picker/picker": "^2.11.1",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.4.0",
    "@react-navigation/native": "^7.1.6",
    "@supabase/auth-js": "^2.69.1",
    "@supabase/postgrest-js": "^1.19.4",
    "@supabase/storage-js": "^2.7.3",
    "@supabase/supabase-js": "^2.49.5-next.4",
    "add": "^2.0.6",
    "depcheck": "^1.4.7",
    "dotenv": "^16.5.0",
    "events": "^3.3.0",
    "expo": "~54.0.36",
    "expo-audio": "~1.1.1",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.10",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "pnpm": "^10.15.0",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-polyfill": "^1.2.1",
    "react-native-randombytes": "^3.6.2",
    "react-native-reanimated": "^4.1.3",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-sqlite-storage": "^6.0.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-vector-icons": "^10.2.0",
    "react-native-web": "^0.21.2",
    "react-native-websocket": "^1.0.2",
    "react-native-webview": "^13.15.0",
    "react-native-worklets": "0.5.1",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@react-native-community/cli": "latest",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "@types/react-native": "^0.72.8",
    "@types/react-native-sqlite-storage": "^6.0.5",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/ws": "^8.18.1",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "metro": "^0.83.3",
    "react-native-crypto": "^2.2.0",
    "react-native-udp": "^4.1.7",
    "rn-nodeify": "^10.3.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "private": true,
  "overrides": {
    "react-native": "0.81.5"
  },
  "postinstall": "rn-nodeify --install http,https,ws,stream,crypto,net --hack",
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testMatch": [
      "**/__tests__/**/*.[jt]s?(x)",
      "**/?(*.)+(spec|test).[jt]s?(x)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg)"
    ]
  }
}
